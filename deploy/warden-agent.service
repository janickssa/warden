# Warden agent on a target (README 7A, 12). Install the binary to /usr/local/bin/warden-agent.
[Unit]
Description=Warden agent
After=network-online.target
Wants=network-online.target

[Service]
User=warden
Group=warden
ExecStart=/usr/local/bin/warden-agent run --state /var/lib/warden-agent
Restart=always
RestartSec=5

# State (key, certificate, bundle, executed-plan log) lives here, mode 0700.
StateDirectory=warden-agent
StateDirectoryMode=0700
# HOME for steps (npm cache etc.), kept out of /home.
Environment=HOME=/var/lib/warden-agent/home

# Hardening. Adjust ReadWritePaths to the target's workspace_roots.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/dev /run/warden
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0027

[Install]
WantedBy=multi-user.target
