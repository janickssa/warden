<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- MISSING: replace MISSING_TEAMID with your Apple Team ID (same as App.entitlements). -->
<plist version="1.0">
<dict>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.dk.schwabejss.warden</string>
    </array>
    <key>keychain-access-groups</key>
    <array>
        <string>MISSING_TEAMID.dk.schwabejss.warden</string>
    </array>
</dict>
</plist>
